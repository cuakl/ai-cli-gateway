{
  "name": "ai-cli-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "AI CLI gateway and frontend DevTools overlay monorepo",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "pnpm --filter demo-react-app e2e",
    "demo": "pnpm --filter demo-react-app dev"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["node-pty"]
  }
}
