{
  "name": "@aidev/adapters",
  "version": "0.0.1",
  "description": "CLI adapter abstraction, binary resolution, and process supervision",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@aidev/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
