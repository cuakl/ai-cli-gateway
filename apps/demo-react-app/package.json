{
  "name": "demo-react-app",
  "version": "0.0.1",
  "private": true,
  "description": "React + Vite app for exercising the DevTools overlay and Vite plugin",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "pnpm -w exec turbo run build --filter=@aidev/gateway --filter=@aidev/vite && tsx e2e/loop.ts"
  },
  "dependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@aidev/vite": "workspace:*",
    "@aidev/gateway": "workspace:*",
    "@aidev/protocol": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^17.6.3",
    "playwright": "^1.55.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
